{
  "schema_version": 1,
  "workflow_id": "build-persona",
  "stage_defaults": {
    "allowed_tools": [
      "ask_user",
      "file_read",
      "file_write",
      "find_files",
      "search_files",
      "shell",
      "task"
    ],
    "conditional_authorities": [],
    "writes_allowed": []
  },
  "stages": [
    {
      "id": "persona_intake",
      "order": 1,
      "purpose": "confirm persona-building scope, consent boundaries, and candidate patch destination",
      "mode_paths": [
        "workflows/build-persona/persona-intake.md"
      ],
      "required_init_fields": [],
      "loaded_authorities": [
        "workflows/build-persona/persona-intake.md"
      ],
      "must_not_eager_load": [
        "workflows/build-persona/source-ingestion.md",
        "workflows/build-persona/persona-synthesis.md",
        "workflows/build-persona/approval-and-apply.md"
      ],
      "produced_state": [
        "persona consent scope",
        "persona evidence intake plan"
      ],
      "next_stages": [
        "source_ingestion"
      ],
      "checkpoints": [
        "explicit consent recorded before interview or source read",
        "raw private profile is not injected into prompt context",
        "candidate patch path selected"
      ]
    },
    {
      "id": "source_ingestion",
      "order": 2,
      "purpose": "convert explicitly approved source handles into candidate persona patches",
      "mode_paths": [
        "workflows/build-persona/source-ingestion.md"
      ],
      "required_init_fields": [],
      "loaded_authorities": [
        "workflows/build-persona/source-ingestion.md"
      ],
      "must_not_eager_load": [
        "workflows/build-persona/persona-synthesis.md",
        "workflows/build-persona/approval-and-apply.md"
      ],
      "allowed_tools": [
        "ask_user",
        "file_read",
        "file_write",
        "find_files",
        "search_files",
        "shell"
      ],
      "writes_allowed": [
        "GPD/persona/source-candidate-patch.json",
        "GPD/persona/source-ingestion-summary.md"
      ],
      "produced_state": [
        "source ingestion patch",
        "source privacy and confidence notes",
        "source schema warnings"
      ],
      "next_stages": [
        "persona_synthesis"
      ],
      "checkpoints": [
        "exact source category and path or text approved before read",
        "gpd research-persona ingest-source used for source-derived candidates",
        "candidate artifacts only; no persona storage mutation"
      ]
    },
    {
      "id": "persona_synthesis",
      "order": 3,
      "purpose": "delegate patch-only persona synthesis and validate the candidate patch",
      "mode_paths": [
        "workflows/build-persona/persona-synthesis.md"
      ],
      "required_init_fields": [],
      "loaded_authorities": [
        "workflows/build-persona/persona-synthesis.md"
      ],
      "must_not_eager_load": [
        "workflows/build-persona/source-ingestion.md",
        "workflows/build-persona/approval-and-apply.md"
      ],
      "writes_allowed": [
        "GPD/persona/candidate-patch.json",
        "GPD/persona/candidate-summary.md"
      ],
      "produced_state": [
        "candidate ResearchPersonaPatch",
        "privacy and confidence summary"
      ],
      "next_stages": [
        "approval_and_apply"
      ],
      "checkpoints": [
        "builder returns patch proposal only",
        "candidate patch validates and diffs with local CLI",
        "never_prompt material remains out of prompt-facing summaries"
      ]
    },
    {
      "id": "approval_and_apply",
      "order": 4,
      "purpose": "present diff, require explicit approval, and route any mutation through the local CLI",
      "mode_paths": [
        "workflows/build-persona/approval-and-apply.md"
      ],
      "required_init_fields": [],
      "loaded_authorities": [
        "workflows/build-persona/approval-and-apply.md"
      ],
      "must_not_eager_load": [
      ],
      "produced_state": [
        "approval decision",
        "post-approval validation status",
        "prompt-safe capsule and application preview guidance"
      ],
      "next_stages": [],
      "checkpoints": [
        "diff reviewed before apply",
        "explicit user approval collected before mutation",
        "application uses gpd research-persona apply-patch only",
        "post-apply guidance exports prompt-safe capsules only",
        "Researcher Doppelganger, Expertise-Aware Explanation, and Scientific Taste previews remain advisory and non-mutating"
      ]
    }
  ]
}
